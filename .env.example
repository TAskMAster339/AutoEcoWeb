# Copy to .env — the single source of truth for ALL container environment.
# backend, postgres and frontend services load the whole file via
# `env_file: .env` (see docker-compose.dev.yml / docker-compose.deploy.yml).
#
# POSTGRES_* — used by postgres image (USER/PASSWORD/DB_NAME) and by the
# FastAPI backend (pydantic-settings reads the same names).
# JWT_SECRET — signing key for auth tokens (backend).
# VITE_* — frontend (Vite): exposed to the client bundle as import.meta.env.
#   - VITE_API_URL: base URL of the backend API; empty = same origin
#     (dev proxy → backend).
#   - VITE_PROXY_TARGET: dev-only, read by vite.config.ts (server-side).
#     Inside compose it must be the service name (http://backend:80);
#     host dev without compose falls back to http://localhost:80.
#   - VITE_USE_MOCK_API: 'true' serves transactions/summary/tags/rules/
#     analytics from mock data until backend endpoints exist (see
#     frontend/TODO.md). Auth always uses the real API. Override for
#     production: VITE_USE_MOCK_API=false make deploy-up.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAME=postgres

JWT_SECRET=very_secret_key

VITE_API_URL=
VITE_PROXY_TARGET=http://backend:80
VITE_USE_MOCK_API=true
