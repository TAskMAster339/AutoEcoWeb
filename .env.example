# Copy to .env — the single source of truth for ALL container environment.
# backend, postgres and frontend services load the whole file via
# `env_file: .env` (see docker-compose.dev.yml / docker-compose.deploy.yml).
#
# POSTGRES_* — used by postgres image (USER/PASSWORD/DB_NAME) and by the
# FastAPI backend (pydantic-settings reads the same names).
# JWT_SECRET — signing key for auth tokens (backend).
# VITE_* — frontend (Vite): exposed to the client bundle as import.meta.env.
#   - VITE_API_URL: base URL of the backend API; empty = same origin
#     (dev proxy → backend).
#   - VITE_PROXY_TARGET: dev-only, read by vite.config.ts (server-side).
#     Inside compose it must be the service name (http://backend:80);
#     host dev without compose falls back to http://localhost:80.
#   - VITE_USE_MOCK_API: 'true' serves transactions/summary/tags/rules/
#     analytics from mock data until backend endpoints exist (see
#     frontend/TODO.md). Auth always uses the real API. Override for
#     production: VITE_USE_MOCK_API=false make deploy-up.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAME=postgres

JWT_SECRET=very_secret_key

VITE_API_URL=
VITE_PROXY_TARGET=http://backend:80
VITE_USE_MOCK_API=true
COOKIE_SECURE=false
# Публичный адрес фронтенда — используется в кнопках писем подтверждения.
APP_URL=https://autoeco.mooo.com

# ---------------------------------------------------------------------------
# SMTP: отправка писем с кодами (подтверждение почты / сброс пароля)
# ---------------------------------------------------------------------------
# Если SMTP_HOST пуст — письма не отправляются, код пишется в лог бэкенда
# (удобно для разработки).
#
# КАК ЗАВЕСТИ GMAIL ДЛЯ ОТПРАВКИ ПИСЕМ:
#   1. Создайте обычный аккаунт Google (или используйте существующий):
#      https://accounts.google.com/signup
#   2. Включите двухэтапную аутентификацию:
#      https://myaccount.google.com/security -> «Двухэтапная аутентификация»
#      (пароль приложения работает только при включённой 2FA)
#   3. Создайте пароль приложения:
#      https://myaccount.google.com/apppasswords
#      Имя приложения: например «AutoEco». Google покажет 16 символов
#      (4 блока по 4, пробелы вводить не нужно) — это и есть SMTP_PASSWORD.
#   4. SMTP_FROM обычно = ваш адрес gmail (SMTP_USERNAME).
#   Примечание: если Google блокирует вход «менее безопасных приложений»,
#   включите https://myaccount.google.com/lesssecureapps (устаревший путь)
#   — для новых аккаунтов его больше нет, используйте пароль приложения.
SMTP_HOST=smtp.gmail.com
# Некоторые сети/провайдеры блокируют 587 — тогда используйте 465 (SSL):
# SMTP_PORT=465, SMTP_STARTTLS=false, SMTP_SSL=true
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Gmail: STARTTLS на 587. Для SSL-порта 465: SMTP_STARTTLS=false, SMTP_SSL=true.
SMTP_STARTTLS=true
SMTP_SSL=false
